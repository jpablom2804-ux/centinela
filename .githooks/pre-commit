#!/bin/sh
# Bloquea el commit si gitleaks encuentra un secreto en lo que está preparado (staged).
# Se activa una vez por clon:  git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks no está instalado, así que no se puede verificar que no haya secretos." >&2
  echo "Instálalo (winget install Gitleaks.Gitleaks / dnf install gitleaks) y vuelve a intentar." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner .
