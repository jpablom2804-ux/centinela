# Copiar a .env. Aquí va SOLO configuración que no es secreta (ADR-005).
# Las contraseñas y la API key NO van aquí:
#   - contraseñas de PostgreSQL y RabbitMQ: archivos en secrets/ (./scripts/secretos.sh generar)
#   - API key del LLM en desarrollo: dotnet user-secrets (fase 1)

# PostgreSQL
POSTGRES_DB=centinela
POSTGRES_USER=centinela_admin

# Agente (fase 1)
LLM_MODELO=
AGENTE_MAX_ITERACIONES=6
AGENTE_MAX_TOKENS_TICKET=20000
AGENTE_TIMEOUT_SEGUNDOS=60
AGENTE_UMBRAL_SIMILITUD=0.80

# Agente (fase 3)
AGENTE_MAX_TOKENS_DIA=500000
