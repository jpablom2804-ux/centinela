# Copiar a .env y completar. Nunca versionar .env.
# Las contraseñas vacías hacen fallar `docker compose up` a propósito.

# PostgreSQL: administrador (solo para crear roles y esquemas)
POSTGRES_DB=centinela
POSTGRES_USER=centinela_admin
POSTGRES_PASSWORD=

# PostgreSQL: roles por servicio (se crean en el primer arranque)
MESA_SERVICIO_DB_PASSWORD=
MESA_SERVICIO_APP_DB_PASSWORD=
AGENTE_DB_PASSWORD=
POWERBI_RO_DB_PASSWORD=

# RabbitMQ
RABBITMQ_DEFAULT_USER=centinela
RABBITMQ_DEFAULT_PASS=

# Agente (fase 1)
LLM_API_KEY=
LLM_MODELO=
AGENTE_MAX_ITERACIONES=6
AGENTE_MAX_TOKENS_TICKET=20000
AGENTE_TIMEOUT_SEGUNDOS=60
AGENTE_UMBRAL_SIMILITUD=0.80

# Agente (fase 3)
AGENTE_MAX_TOKENS_DIA=500000
