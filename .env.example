# Copiar a .env. Aquí va SOLO configuración que no es secreta (ADR-005).
# Las contraseñas y la API key NO van aquí:
#   - contraseñas de PostgreSQL y RabbitMQ: archivos en secrets/ (./scripts/secretos.sh generar)
#   - API key del LLM en desarrollo: dotnet user-secrets (ver services/agente/README.md)

# PostgreSQL
POSTGRES_DB=centinela
POSTGRES_USER=centinela_admin

# Agente. Los valores por defecto están en services/agente/src/Centinela.Agente/appsettings.json;
# estas variables los sobrescriben (formato .NET: Seccion__Clave). En la fase 3 las pasa compose.
# Llm__Modelo=claude-opus-5-5
# Llm__Esfuerzo=medium
# Agente__MaxIteraciones=6
# Agente__MaxTokensTicket=40000
# Agente__TimeoutSegundos=90

# Agente (fase 3)
# Agente__UmbralSimilitud=0.80
# Agente__MaxTokensDia=500000
